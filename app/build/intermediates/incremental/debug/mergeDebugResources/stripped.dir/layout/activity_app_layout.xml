<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_glassmorphism"
    android:padding="16dp">

    <!-- Status Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/glass_surface"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        android:layout_marginBottom="12dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/glass_border">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚡"
                    android:textSize="20sp"
                    android:layout_marginEnd="12dp"/>

                <TextView
                    android:id="@+id/status_text_view"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Status: Verbinde..."
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/connection_quality_view"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📶"
                    android:textSize="14sp"
                    android:layout_marginEnd="8dp"
                    android:visibility="gone"
                    android:textColor="@color/soft_cyan"/>

                <ProgressBar
                    android:id="@+id/reconnect_progress"
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:indeterminate="true"
                    android:visibility="gone"
                    android:indeterminateTint="@color/soft_cyan" />

            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/connect_button"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="🔄 Manueller Reconnect"
                style="@style/Widget.Glass.Button.Primary"
                android:layout_marginTop="12dp"
                android:textSize="14sp" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Auth Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/login_button"
            style="@style/Widget.Glass.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="🔐 Login"
            android:layout_marginEnd="6dp"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/register_button"
            style="@style/Widget.Glass.Button.Secondary"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="✨ Registrieren"
            android:layout_marginStart="6dp"
            android:textSize="14sp" />

    </LinearLayout>

    <!-- Admin/Supervisor Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/admin_button"
            style="@style/Widget.Glass.Button.Secondary"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="🔧 Admin Panel"
            android:layout_marginEnd="6dp"
            android:visibility="gone"
            android:textSize="14sp"
            app:strokeWidth="1dp"
            app:strokeColor="#FF9800" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/supervisor_button"
            style="@style/Widget.Glass.Button.Secondary"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="👁️ Supervisor"
            android:layout_marginStart="6dp"
            android:visibility="gone"
            android:textSize="14sp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/soft_purple" />

    </LinearLayout>

    <!-- Visitors List Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:cardBackgroundColor="@color/glass_surface"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/glass_border">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/glass_surface_dark"
                android:padding="16dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📞"
                    android:textSize="18sp"
                    android:layout_marginEnd="12dp"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Wartende Besucher"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/visitor_count_badge"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:text="0"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium"
                    android:background="@drawable/glass_button_primary"
                    android:gravity="center" />

            </LinearLayout>

            <!-- RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/live_visitors_recycler"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="12dp"
                android:clipToPadding="false"
                tools:listitem="@layout/visitor_list_item_glass" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Active Call Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/active_call_layout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:cardBackgroundColor="@color/glass_surface"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        android:visibility="gone"
        android:layout_marginTop="12dp"
        app:strokeWidth="2dp"
        app:strokeColor="#FF9800"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Call Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/glass_surface_dark"
                android:padding="16dp"
                android:gravity="center"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📞 LIVE ANRUF"
                    android:textColor="#FF9800"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/active_call_info"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Im Gespräch mit..."
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:gravity="center"/>

            </LinearLayout>

            <!-- Avatar -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_gravity="center"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/glass_surface_dark"
                app:cardCornerRadius="60dp"
                app:cardElevation="2dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/glass_border">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/app_logo"
                    android:scaleType="fitCenter"
                    android:contentDescription="Call Avatar"/>

            </com.google.android.material.card.MaterialCardView>

            <!-- Chat Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                app:cardBackgroundColor="@color/glass_surface_dark"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/glass_border">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <!-- Chat Header -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/glass_surface"
                        android:padding="12dp"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="💬"
                            android:textSize="16sp"
                            android:layout_marginEnd="8dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="CHAT"
                            android:textColor="@color/soft_cyan"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-medium"/>

                    </LinearLayout>

                    <!-- Messages -->
                    <ScrollView
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:padding="12dp">

                        <TextView
                            android:id="@+id/chat_messages_view"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            android:lineSpacingExtra="4dp"
                            android:fontFamily="sans-serif"
                            tools:text="[12:34] Agent: Hallo!\n[12:35] Besucher: Hi!"/>

                    </ScrollView>

                    <!-- Chat Input -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="12dp"
                        android:background="@color/glass_surface"
                        android:gravity="center_vertical">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/chat_input"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="Nachricht..."
                            android:textColor="@color/text_primary"
                            android:textColorHint="@color/text_muted"
                            android:background="@drawable/glass_input"
                            android:padding="12dp"
                            android:textSize="14sp"
                            android:inputType="text"
                            android:imeOptions="actionSend"
                            android:maxLines="3"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/chat_send_button"
                            style="@style/Widget.Glass.Button.Primary"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:text="📤"
                            android:layout_marginStart="8dp"
                            android:minWidth="48dp"
                            android:textSize="16sp"/>

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- End Call Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/call_end_button"
                style="@style/Widget.Glass.Button"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="📞 AUFLEGEN"
                app:backgroundTint="#F44336"
                android:textColor="@android:color/white"
                android:layout_marginTop="16dp"
                android:textSize="15sp"
                android:fontFamily="sans-serif-medium"/>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/visitor_data_text_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        tools:text="Legacy Placeholder"/>

</LinearLayout>