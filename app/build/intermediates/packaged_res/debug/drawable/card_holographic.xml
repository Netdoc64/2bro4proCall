<?xml version="1.0" encoding="utf-8"?>
<!-- Holographic Glass Card - Translucent with Glow Border -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    
    <!-- Rounded corners (24dp for modern look) -->
    <corners android:radius="24dp" />
    
    <!-- Translucent smoke glass background -->
    <solid android:color="@color/glass_smoke" />
    
    <!-- Subtle white border (can be swapped to aurora_cyan for active states) -->
    <stroke
        android:width="1dp"
        android:color="@color/glass_border_subtle" />
    
</shape>
