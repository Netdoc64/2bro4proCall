<?xml version="1.0" encoding="utf-8"?>
<!-- Neon Gradient Button - Cyan to Purple -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    
    <!-- Stadium/Pill shape (fully rounded) -->
    <corners android:radius="100dp" />
    
    <!-- Horizontal gradient: Cyan → Purple -->
    <gradient
        android:type="linear"
        android:angle="0"
        android:startColor="@color/aurora_cyan"
        android:endColor="@color/aurora_purple" />
    
</shape>
