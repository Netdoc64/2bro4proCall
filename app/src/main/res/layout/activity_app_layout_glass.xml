<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_glassmorphism">

    <!-- App Header -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/glass_surface"
        app:cardCornerRadius="0dp"
        app:cardElevation="2dp"
        app:strokeWidth="0dp"
        app:strokeColor="@android:color/transparent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center_vertical">

            <!-- App Logo/Title -->
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="📞 2bro4Call"
                android:textColor="@color/soft_purple"
                android:textSize="18sp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.03" />

            <!-- User Info Badge -->
            <TextView
                android:id="@+id/user_info_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👤"
                android:textSize="16sp"
                android:visibility="gone"
                android:layout_marginEnd="12dp"
                android:padding="8dp"
                android:background="@drawable/glass_button_primary"
                android:textColor="@color/text_primary" />

            <!-- Menu Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/menu_button"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:text="☰"
                android:textSize="20sp"
                android:textColor="@color/soft_purple"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                android:minWidth="40dp"
                android:minHeight="40dp" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

        <!-- Status Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/glass_surface"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            android:layout_marginBottom="16dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/glass_border">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⚡"
                        android:textSize="22sp"
                        android:layout_marginEnd="12dp"/>

                    <TextView
                        android:id="@+id/status_text_view"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Status: Initialisiere..."
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif-medium"
                        android:lineSpacingExtra="2dp" />

                    <TextView
                        android:id="@+id/connection_quality_view"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📶"
                        android:textSize="14sp"
                        android:layout_marginEnd="8dp"
                        android:visibility="gone"
                        android:textColor="@color/soft_cyan"/>

                    <ProgressBar
                        android:id="@+id/reconnect_progress"
                        style="?android:attr/progressBarStyleSmall"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:indeterminate="true"
                        android:visibility="gone"
                        android:indeterminateTint="@color/soft_cyan" />

                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/connect_button"
                    style="@style/Widget.Glass.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="🔄 Manueller Reconnect"
                    android:textSize="14sp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Auth Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/login_button"
                style="@style/Widget.Glass.Button.Primary"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="🔐 Login"
                android:layout_marginEnd="6dp"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/register_button"
                style="@style/Widget.Glass.Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="✨ Register"
                android:layout_marginStart="6dp"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- Admin/Supervisor Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/admin_button"
                style="@style/Widget.Glass.Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="🔧 Admin Panel"
                android:layout_marginEnd="6dp"
                android:visibility="gone"
                android:textSize="14sp"
                app:strokeWidth="1dp"
                app:strokeColor="#FF9800" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/supervisor_button"
                style="@style/Widget.Glass.Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="👁️ Supervisor"
                android:layout_marginStart="6dp"
                android:visibility="gone"
                android:textSize="14sp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/soft_purple" />

        </LinearLayout>

        <!-- Visitors List Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="380dp"
            app:cardBackgroundColor="@color/glass_surface"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            android:layout_marginBottom="16dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/glass_border">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <!-- Header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@color/glass_surface_dark"
                    android:padding="16dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📞"
                        android:textSize="18sp"
                        android:layout_marginEnd="12dp"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Wartende Besucher"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:id="@+id/visitor_count_badge"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:text="0"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif-medium"
                        android:background="@drawable/glass_button_primary"
                        android:gravity="center" />

                </LinearLayout>

                <!-- RecyclerView -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/live_visitors_recycler"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="12dp"
                    android:clipToPadding="false"
                    tools:listitem="@layout/visitor_list_item_glass" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Active Call Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/active_call_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/glass_surface"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            android:visibility="gone"
            android:layout_marginBottom="16dp"
            app:strokeWidth="2dp"
            app:strokeColor="#FF9800">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📞"
                        android:textSize="20sp"
                        android:layout_marginEnd="12dp"/>

                    <TextView
                        android:id="@+id/active_call_info"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Aktiver Anruf..."
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:fontFamily="sans-serif-medium" />

                </LinearLayout>

                <!-- Chat Messages -->
                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:background="@color/glass_surface_dark"
                    android:padding="12dp"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:id="@+id/chat_messages_view"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif"
                        android:lineSpacingExtra="4dp" />

                </ScrollView>

                <!-- Chat Input -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">

                    <EditText
                        android:id="@+id/chat_input"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:hint="Nachricht..."
                        android:textColorHint="@color/text_muted"
                        android:textColor="@color/text_primary"
                        android:background="@drawable/glass_input"
                        android:padding="12dp"
                        android:layout_marginEnd="8dp"
                        android:fontFamily="sans-serif"
                        android:textSize="14sp"
                        android:imeOptions="actionSend"
                        android:inputType="textCapSentences|textAutoCorrect"
                        android:maxLines="3" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/chat_send_button"
                        style="@style/Widget.Glass.Button.Primary"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:text="📤"
                        android:textSize="16sp"
                        android:paddingLeft="16dp"
                        android:paddingRight="16dp" />

                </LinearLayout>

                <!-- End Call Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/call_end_button"
                    style="@style/Widget.Glass.Button"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="📵 Anruf beenden"
                    android:backgroundTint="#EF4444"
                    android:textColor="@android:color/white"
                    android:textSize="15sp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </ScrollView>

</LinearLayout>