<?xml version="1.0" encoding="utf-8"?>
<!-- Aurora Dark Theme - Visitor List Item -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@android:color/transparent"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    android:layout_marginBottom="8dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/glass_border_subtle">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/card_holographic"
        android:padding="12dp"
        android:gravity="center_vertical">

        <!-- Avatar Circle -->
        <TextView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="👤"
            android:textSize="20sp"
            android:background="@drawable/btn_outline_cyan"
            android:textColor="@color/aurora_cyan"
            android:gravity="center"
            android:layout_marginEnd="12dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/visitor_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Besucher"
                android:textSize="14sp"
                android:textColor="@color/text_bright"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="2dp" />

            <TextView
                android:id="@+id/visitor_domain"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Domain"
                android:textSize="11sp"
                android:textColor="@color/text_dim"
                android:fontFamily="sans-serif" />

        </LinearLayout>

        <!-- Button Container -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/chat_visitor_button"
                style="@style/Widget.Glass.Button.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/btn_outline_cyan"
                android:text="💬"
                android:textColor="@color/aurora_purple"
                android:textSize="14sp"
                android:minWidth="40dp"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:layout_marginEnd="6dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/aurora_purple" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/call_visitor_button"
                style="@style/Widget.Glass.Button.Success"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/btn_neon"
                android:text="📞"
                android:textColor="@color/void_dark"
                android:textSize="14sp"
                android:minWidth="40dp"
                android:paddingLeft="8dp"
                android:paddingRight="8dp" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>